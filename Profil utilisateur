<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Profil - Miracle GB</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            margin: 0;
        }

        header {
            background: #111;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .profil {
            max-width: 600px;
            margin: 30px auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
        }

        .photo {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: #ddd;
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
        }

        .nom {
            font-size: 28px;
            font-weight: bold;
        }

        .description {
            color: #666;
            margin: 10px 0 25px;
        }

        .stats {
            display: flex;
            justify-content: space-around;
            margin: 25px 0;
        }

        .stat {
            font-size: 18px;
        }

        button {
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            background: #111;
            color: white;
        }

        a {
            display: block;
            margin-top: 20px;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <header>
        <h1>Miracle GB</h1>
    </header>

    <div class="profil">

        <div class="photo">
            👤
        </div>

        <div class="nom">
            Miracle GB
        </div>

        <p class="description">
            Bienvenue sur mon profil Miracle GB.
        </p>

        <div class="stats">

            <div class="stat">
                <strong>0</strong><br>
                Publications
            </div>

            <div class="stat">
                <strong>0</strong><br>
                Abonnés
            </div>

            <div class="stat">
                <strong>0</strong><br>
                Abonnements
            </div>

        </div>

        <button onclick="modifierProfil()">
            ✏️ Modifier le profil
        </button>

        <a href="../index.html">
            🏠 Retour à l'accueil
        </a>

    </div>

    <script>
        function modifierProfil() {
            alert("La modification du profil sera disponible bientôt !");
        }
    </script>

</body>
</html>